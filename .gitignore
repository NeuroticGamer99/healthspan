specs/personal/
*.db
*.db-shm
*.db-wal
*.db.lock
*.sqlite
*.sqlite3
data/

# Export output (plaintext health data — see ADR-0015)
exports/
export/

# Recovery Kit renders (contain the secret key — see ADR-0033)
*recovery-kit*

# Claude Code harness config (ADR-0071): the shared file .claude/settings.json
# is COMMITTED (permissions and hooks reviewed like any other code); anything
# machine-specific — absolute paths, personal grants — goes in
# settings.local.json, which stays local.
.claude/settings.local.json

# Python
.venv/
__pycache__/
*.py[cod]

# Local pytest capture for the log-canary scan (CI regenerates it). The parallel
# (windows-latest) leg's artifacts (ADR-0063) join it: the tee'd controller
# stream and the per-worker capture dir, both hundreds of KB of captured test
# output that must never land in the repo.
pytest-output.log
parallel-output.log
canary-logs/

# Generated by the pip-audit gate's export step (ci.yml), and by anyone
# reproducing that gate locally. Derived from uv.lock, never edited by hand.
requirements-audit.txt
